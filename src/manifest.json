{
	"manifest_version": 2,
	"name": "FlexAnnotate",
	"version": "1.0.0",
	"description": "Annotations for sources without file attachments (e.g. printed books) and citations that include only the source reference in Word/LibreOffice.",
	"homepage_url": "https://github.com/justanotherjurastudent/zotero_flexAnnotations",
	"applications": {
		"zotero": {
			"id": "flexannotate@justanotherjurastudent.github.io",
			"update_url": "https://raw.githubusercontent.com/justanotherjurastudent/zotero_flexAnnotations/main/updates.json",
			"strict_min_version": "7.0",
			"strict_max_version": "10.*"
		}
	}
}
