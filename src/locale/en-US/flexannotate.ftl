flexannotate-prefs-citing-heading = Citing
flexannotate-prefs-citation-only =
    .label = Insert citation only by default
flexannotate-prefs-citation-only-description =
    When inserting annotations in Word or LibreOffice, insert only the citation with its
    page locator — without the quoted text and comment.

flexannotate-prefs-placeholder-heading = Placeholders
flexannotate-prefs-keep-placeholders =
    .label = Keep empty placeholder attachments
flexannotate-prefs-keep-placeholders-description =
    Print annotations need a file attachment as a technical carrier. With this option off,
    FlexAnnotate removes the placeholder once its last annotation has been deleted.
